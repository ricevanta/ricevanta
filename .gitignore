.DS_Store
*.swp

# Shared agent definitions: role files only; other tool state stays local.
!/.claude/
/.claude/*
!/.claude/agents/
/.claude/agents/**
!/.claude/agents/**/
!/.claude/agents/**/*.md
/.claude/agents/**/agent-memory*/
!/.codex/

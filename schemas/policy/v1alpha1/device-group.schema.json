{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ricevanta.io/schemas/policy/v1alpha1/device-group.schema.json",
  "title": "DeviceGroup",
  "description": "Static members and selector matches form a union. Selector fields and expressions are ANDed; OS keys are ORed. NotIn requires key existence. Version ordering and organization-scoped device resolution belong to compilation. Semantic preflight enforces aggregate budgets. Membership is not an authorization grant.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "ricevanta.io/v1alpha1"
    },
    "kind": {
      "const": "DeviceGroup"
    },
    "metadata": {
      "$ref": "mdm-common.schema.json#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20000,
          "items": {
            "$ref": "mdm-common.schema.json#/$defs/name"
          },
          "uniqueItems": true
        },
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "matchLabels": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 16,
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[^\\x00-\\x1f\\x7f\\ud800-\\udfff]*(?![\\s\\S])"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 0,
                "maxLength": 63,
                "pattern": "^[^\\x00-\\x1f\\x7f\\ud800-\\udfff]*(?![\\s\\S])"
              }
            },
            "matchExpressions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63,
                    "pattern": "^[^\\x00-\\x1f\\x7f\\ud800-\\udfff]*(?![\\s\\S])"
                  },
                  "operator": {
                    "enum": [
                      "In",
                      "NotIn",
                      "Exists",
                      "DoesNotExist"
                    ]
                  },
                  "values": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 64,
                    "items": {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 63,
                      "pattern": "^[^\\x00-\\x1f\\x7f\\ud800-\\udfff]*(?![\\s\\S])"
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "key",
                  "operator"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "operator": {
                          "enum": [
                            "In",
                            "NotIn"
                          ]
                        }
                      },
                      "required": [
                        "operator"
                      ]
                    },
                    "then": {
                      "required": [
                        "values"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "operator": {
                          "enum": [
                            "Exists",
                            "DoesNotExist"
                          ]
                        }
                      },
                      "required": [
                        "operator"
                      ]
                    },
                    "then": {
                      "not": {
                        "anyOf": [
                          {
                            "required": [
                              "values"
                            ]
                          }
                        ]
                      }
                    }
                  }
                ]
              },
              "uniqueItems": true
            },
            "os": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "macos": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 16,
                  "pattern": "^[^\\x00-\\x1f\\x7f\\ud800-\\udfff]*(?![\\s\\S])"
                },
                "windows": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 16,
                  "pattern": "^[^\\x00-\\x1f\\x7f\\ud800-\\udfff]*(?![\\s\\S])"
                },
                "linux": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 16,
                  "pattern": "^[^\\x00-\\x1f\\x7f\\ud800-\\udfff]*(?![\\s\\S])"
                }
              },
              "minProperties": 1
            }
          },
          "minProperties": 1
        }
      },
      "minProperties": 1
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ]
}

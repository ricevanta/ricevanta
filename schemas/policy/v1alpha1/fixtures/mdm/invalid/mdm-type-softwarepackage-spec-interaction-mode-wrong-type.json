{
  "apiVersion": "ricevanta.io/v1alpha1",
  "kind": "SoftwarePackage",
  "metadata": {
    "name": "sample"
  },
  "spec": {
    "os": "macos",
    "format": "pkg",
    "name": "app",
    "version": "1.0",
    "source": {
      "type": "blob",
      "blobKey": "packages/app.bin",
      "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "size": 1
    },
    "signature": {
      "type": "developer-id",
      "teamId": "ABCDEFGHIJ"
    },
    "detection": {
      "type": "bundle",
      "identifier": "io.ricevanta.app",
      "version": "1.0"
    },
    "allowedGroups": [
      "fleet"
    ],
    "installArgs": [],
    "uninstallArgs": [],
    "reboot": {
      "mode": "none"
    },
    "interaction": {
      "mode": {}
    }
  }
}

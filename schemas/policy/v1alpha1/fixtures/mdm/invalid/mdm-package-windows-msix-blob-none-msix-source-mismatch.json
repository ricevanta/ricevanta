{
  "apiVersion": "ricevanta.io/v1alpha1",
  "kind": "SoftwarePackage",
  "metadata": {
    "name": "sample"
  },
  "spec": {
    "os": "windows",
    "format": "msix",
    "name": "app",
    "version": "1.0",
    "source": {
      "type": "repository",
      "manager": "flatpak",
      "ref": "repo",
      "package": "app"
    },
    "signature": {
      "type": "none",
      "reason": "Reviewed unsigned artifact",
      "allowUnsigned": true
    },
    "detection": {
      "type": "msix",
      "family": "Example_App",
      "version": "1.0"
    },
    "allowedGroups": [
      "fleet"
    ],
    "installArgs": [],
    "uninstallArgs": [],
    "reboot": {
      "mode": "none"
    },
    "interaction": {
      "mode": "silent"
    }
  }
}

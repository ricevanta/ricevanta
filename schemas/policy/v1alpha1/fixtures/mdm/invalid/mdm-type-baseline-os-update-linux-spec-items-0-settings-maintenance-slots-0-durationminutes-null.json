{
  "apiVersion": "ricevanta.io/v1alpha1",
  "kind": "Baseline",
  "metadata": {
    "name": "sample"
  },
  "spec": {
    "os": "linux",
    "items": [
      {
        "id": "item",
        "kind": "os_update",
        "settings": {
          "platform": "linux",
          "maintenance": {
            "timezone": "UTC",
            "slots": [
              {
                "days": [
                  "mon"
                ],
                "start": "02:00",
                "durationMinutes": null
              }
            ]
          },
          "reboot": {
            "notify": "1h",
            "maxDeferrals": 1,
            "deadline": "1d"
          },
          "class": "security",
          "includeFlatpak": true
        },
        "required": true,
        "severity": "high"
      }
    ],
    "allowedGroups": [
      "fleet"
    ]
  }
}

{
  "apiVersion": "ricevanta.io/v1alpha1",
  "kind": "Baseline",
  "metadata": {
    "name": "sample"
  },
  "spec": {
    "os": "linux",
    "items": [
      {
        "id": "item",
        "kind": "linux.repository",
        "settings": {
          "manager": "apt",
          "name": "example",
          "url": "https://example.org/repo",
          "key": {
            "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          },
          "suite": "stable",
          "components": [
            "main"
          ]
        },
        "required": true,
        "severity": "high"
      }
    ],
    "allowedGroups": [
      "fleet"
    ]
  }
}

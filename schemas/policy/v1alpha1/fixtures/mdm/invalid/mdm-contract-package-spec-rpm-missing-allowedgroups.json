{
  "apiVersion": "ricevanta.io/v1alpha1",
  "kind": "SoftwarePackage",
  "metadata": {
    "name": "sample"
  },
  "spec": {
    "os": "linux",
    "format": "rpm",
    "name": "app",
    "version": "1.0",
    "source": {
      "type": "blob",
      "blobKey": "packages/app.bin",
      "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "size": 1
    },
    "signature": {
      "type": "openpgp",
      "fingerprints": [
        "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
      ]
    },
    "detection": {
      "type": "package",
      "name": "app",
      "version": "1.0"
    },
    "installArgs": [],
    "uninstallArgs": [],
    "reboot": {
      "mode": "none"
    },
    "interaction": {
      "mode": "silent"
    }
  }
}

{
  "apiVersion": "ricevanta.io/v1alpha1",
  "kind": "SoftwarePackage",
  "metadata": {
    "name": "sample"
  },
  "spec": {
    "os": "linux",
    "format": "rpm",
    "name": "app",
    "version": "1.0",
    "source": {
      "type": "blob",
      "blobKey": "packages/app.bin",
      "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "size": 1
    },
    "signature": {
      "type": "none",
      "reason": "Reviewed unsigned artifact",
      "allowUnsigned": true
    },
    "detection": {
      "type": "uninstall",
      "hive": "HKLM",
      "view": 64,
      "key": "Example",
      "version": "1.0"
    },
    "allowedGroups": [
      "fleet"
    ],
    "installArgs": [],
    "uninstallArgs": [],
    "reboot": {
      "mode": "none"
    },
    "interaction": {
      "mode": "silent"
    }
  }
}

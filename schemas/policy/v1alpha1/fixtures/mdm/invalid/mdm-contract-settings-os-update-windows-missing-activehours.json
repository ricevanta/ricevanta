{
  "apiVersion": "ricevanta.io/v1alpha1",
  "kind": "Baseline",
  "metadata": {
    "name": "sample"
  },
  "spec": {
    "os": "windows",
    "items": [
      {
        "id": "item",
        "kind": "os_update",
        "settings": {
          "platform": "windows",
          "maintenance": {
            "timezone": "UTC",
            "slots": [
              {
                "days": [
                  "mon"
                ],
                "start": "02:00",
                "durationMinutes": 60
              }
            ]
          },
          "reboot": {
            "notify": "1h",
            "maxDeferrals": 1,
            "deadline": "1d"
          },
          "productVersion": "Windows11",
          "targetRelease": "latest",
          "qualityDeferralDays": 0,
          "featureDeferralDays": 0,
          "qualityDeadlineDays": 0,
          "featureDeadlineDays": 0,
          "graceDays": 0
        },
        "required": true,
        "severity": "high"
      }
    ],
    "allowedGroups": [
      "fleet"
    ]
  }
}

{
  "apiVersion": "ricevanta.io/v1alpha1",
  "kind": "Baseline",
  "metadata": {
    "name": "sample",
    "labels": {
      "site": "lab"
    },
    "annotations": {
      "owner": "team"
    },
    "description": "Managed resource"
  },
  "spec": {
    "os": "macos",
    "items": [
      {
        "id": "item",
        "kind": "os_update",
        "settings": {
          "platform": "macos",
          "maintenance": {
            "timezone": "UTC",
            "slots": [
              {
                "days": [
                  "mon"
                ],
                "start": "02:00",
                "durationMinutes": 60
              }
            ]
          },
          "reboot": {
            "notify": "1h",
            "maxDeferrals": 1,
            "deadline": "1d"
          },
          "targetVersion": "15.0",
          "deferrals": {
            "majorDays": 0,
            "minorDays": 0,
            "systemDays": 0
          },
          "automaticDownload": true,
          "automaticInstall": true,
          "notifications": true,
          "targetBuild": "24A"
        },
        "required": true,
        "severity": "high",
        "grace": "24h",
        "authority": "native",
        "references": [
          {
            "framework": "cis",
            "id": "1.1",
            "document": "control",
            "version": "1"
          }
        ]
      }
    ],
    "allowedGroups": [
      "fleet"
    ],
    "minOsVersion": "1.0"
  }
}

{
  "apiVersion": "ricevanta.io/v1alpha1",
  "kind": "SoftwarePackage",
  "metadata": {
    "name": "sample"
  },
  "spec": {
    "os": "linux",
    "format": "deb",
    "name": "app",
    "version": "1.0",
    "source": {
      "type": "repository",
      "manager": "apt",
      "ref": "repo",
      "package": "app"
    },
    "signature": {
      "type": "openpgp",
      "fingerprints": [
        "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
      ]
    },
    "detection": {
      "type": "package",
      "name": "app",
      "version": "1.0"
    },
    "allowedGroups": [
      "fleet"
    ],
    "installArgs": [],
    "uninstallArgs": [],
    "reboot": {
      "mode": "none"
    },
    "interaction": {
      "mode": "silent"
    }
  }
}

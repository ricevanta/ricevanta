{
  "apiVersion": "ricevanta.io/v1alpha1",
  "kind": "Baseline",
  "metadata": {
    "name": "sample",
    "labels": {
      "site": "lab"
    },
    "annotations": {
      "owner": "team"
    },
    "description": "Managed resource"
  },
  "spec": {
    "os": "windows",
    "items": [
      {
        "id": "item",
        "kind": "windows.registry",
        "settings": {
          "hive": "HKLM",
          "view": 64,
          "key": "SOFTWARE\\Ricevanta",
          "name": "",
          "type": "string",
          "value": ""
        },
        "required": true,
        "severity": "high",
        "grace": "24h",
        "authority": "agent",
        "references": [
          {
            "framework": "cis",
            "id": "1.1",
            "document": "control",
            "version": "1"
          }
        ]
      }
    ],
    "allowedGroups": [
      "fleet"
    ],
    "minOsVersion": "1.0"
  }
}

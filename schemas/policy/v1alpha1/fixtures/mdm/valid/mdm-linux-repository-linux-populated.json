{
  "apiVersion": "ricevanta.io/v1alpha1",
  "kind": "Baseline",
  "metadata": {
    "name": "sample",
    "labels": {
      "site": "lab"
    },
    "annotations": {
      "owner": "team"
    },
    "description": "Managed resource"
  },
  "spec": {
    "os": "linux",
    "items": [
      {
        "id": "item",
        "kind": "linux.repository",
        "settings": {
          "manager": "apt",
          "name": "example",
          "url": "https://example.org/repo",
          "key": {
            "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "fingerprint": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
          },
          "suite": "stable",
          "components": [
            "main"
          ]
        },
        "required": true,
        "severity": "high",
        "grace": "24h",
        "authority": "agent",
        "references": [
          {
            "framework": "cis",
            "id": "1.1",
            "document": "control",
            "version": "1"
          }
        ]
      }
    ],
    "allowedGroups": [
      "fleet"
    ],
    "minOsVersion": "1.0"
  }
}

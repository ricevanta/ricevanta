                },
                "manager": {
                  "const": "homebrew"
                }
              }
            },
            "signature": {
              "properties": {
                "type": {
                  "enum": [
                    "checksum",
                    "none"
                  ]
                }
              }
            },
            "detection": {
              "properties": {
                "type": {
                  "const": "package"
                }
              }
            }
          },
          "not": {
            "anyOf": [
              {

                }
              }
            },
            "detection": {
              "properties": {
                "type": {
                  "const": "bundle"
                }
              }
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "retrySafe"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "os": {
              "const": "macos"
            },
            "format": {
              "const": "homebrew-formula"
            },
            "source": {
              "properties": {

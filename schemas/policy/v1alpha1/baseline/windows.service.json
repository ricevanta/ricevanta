{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ricevanta.io/schemas/policy/v1alpha1/baseline/windows.service.json",
  "title": "windows.service",
  "description": "Semantic validation rejects disabled plus running. Service creation, account credentials and executable paths are outside this contract.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\x00-\\x1f\\x7f\\ud800-\\udfff]*(?![\\s\\S])",
      "allOf": [
        {
          "pattern": "^[^/\\\\]+(?![\\s\\S])"
        }
      ]
    },
    "startType": {
      "enum": [
        "automatic",
        "automatic-delayed",
        "manual",
        "disabled"
      ]
    },
    "state": {
      "enum": [
        "running",
        "stopped"
      ]
    }
  },
  "required": [
    "name",
    "startType",
    "state"
  ],
  "x-ricevanta-effect": "apply",
  "x-ricevanta-protected-publication": true
}

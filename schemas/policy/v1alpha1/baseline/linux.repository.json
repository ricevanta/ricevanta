{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ricevanta.io/schemas/policy/v1alpha1/baseline/linux.repository.json",
  "title": "linux.repository",
  "description": "Semantic validation checks canonical HTTPS authority and decoded segments. Uploaded immutable public key bytes require resolution and approval; fetcher SSRF and native-distribution gates remain required.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "manager": {
      "enum": [
        "apt",
        "dnf",
        "zypper",
        "flatpak"
      ]
    },
    "name": {
      "$ref": "../mdm-common.schema.json#/$defs/name"
    },
    "url": {
      "$ref": "../mdm-common.schema.json#/$defs/https"
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "$ref": "../mdm-common.schema.json#/$defs/hash"
        },
        "fingerprint": {
          "$ref": "../mdm-common.schema.json#/$defs/fingerprint"
        }
      },
      "required": [
        "sha256",
        "fingerprint"
      ]
    },
    "suite": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00-\\x1f\\x7f\\ud800-\\udfff]*(?![\\s\\S])"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[^\\x00-\\x1f\\x7f\\ud800-\\udfff]*(?![\\s\\S])"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "manager",
    "name",
    "url",
    "key"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "manager": {
            "const": "apt"
          }
        },
        "required": [
          "manager"
        ]
      },
      "then": {
        "required": [
          "suite",
          "components"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "manager": {
            "enum": [
              "dnf",
              "zypper",
              "flatpak"
            ]
          }
        },
        "required": [
          "manager"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "suite"
              ]
            },
            {
              "required": [
                "components"
              ]
            }
          ]
        }
      }
    }
  ],
  "x-ricevanta-effect": "apply",
  "x-ricevanta-protected-publication": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ricevanta.io/schemas/policy/v1alpha1/baseline/linux.file.json",
  "title": "linux.file",
  "description": "Semantic validation requires a path strictly below /etc/ and excludes /etc/pam.d and /etc/ricevanta. Native writers reject links, aliases, special files, ownership and dedicated-kind collisions through approved transactions. Aggregate settings bytes need semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "path": {
      "$ref": "../mdm-common.schema.json#/$defs/posixPath"
    },
    "content": {
      "type": "string",
      "minLength": 0,
      "maxLength": 16384,
      "pattern": "^[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f\\ud800-\\udfff]*(?![\\s\\S])"
    },
    "mode": {
      "enum": [
        "0400",
        "0440",
        "0444",
        "0600",
        "0640",
        "0644"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[^\\x00-\\x1f\\x7f\\ud800-\\udfff]*(?![\\s\\S])",
      "allOf": [
        {
          "pattern": "^[a-z_][a-z0-9_-]{0,31}(?![\\s\\S])"
        }
      ]
    },
    "group": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[^\\x00-\\x1f\\x7f\\ud800-\\udfff]*(?![\\s\\S])",
      "allOf": [
        {
          "pattern": "^[a-z_][a-z0-9_-]{0,31}(?![\\s\\S])"
        }
      ]
    }
  },
  "required": [
    "path",
    "content",
    "mode",
    "owner",
    "group"
  ],
  "x-ricevanta-effect": "apply",
  "x-ricevanta-protected-publication": true
}

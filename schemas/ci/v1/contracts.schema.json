{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ricevanta.io/schemas/ci/v1/contracts.schema.json",
  "title": "CI routing, receipt and toolchain contracts",
  "description": "Shape validation only. CI verifies provenance, exact inventories, uniqueness of IDs and payload bytes separately.",
  "oneOf": [
    {
      "$ref": "#/$defs/route"
    },
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/toolchains"
    }
  ],
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version",
        "event",
        "baseSha",
        "headSha",
        "testedSha",
        "runId",
        "runAttempt",
        "groups",
        "units"
      ],
      "properties": {
        "kind": {
          "const": "route"
        },
        "version": {
          "const": 1
        },
        "event": {
          "enum": [
            "pull_request",
            "push"
          ]
        },
        "baseSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "headSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "testedSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "runId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "runAttempt": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version",
        "testedSha",
        "runId",
        "runAttempt",
        "unit",
        "result",
        "checks"
      ],
      "properties": {
        "kind": {
          "const": "receipt"
        },
        "version": {
          "const": 1
        },
        "testedSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "runId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "runAttempt": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "const": "success"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "toolchains": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version",
        "entries"
      ],
      "properties": {
        "kind": {
          "const": "toolchains"
        },
        "version": {
          "const": 1
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/toolchain"
          }
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tool",
        "version",
        "platform",
        "url",
        "size",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "enum": [
            "linux-x64",
            "linux-arm64",
            "windows-x64",
            "macos-arm64"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https://[^ /?#]+/[^ ]+$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}

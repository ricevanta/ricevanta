{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "seed_hex",
    "public_key_hex",
    "publisher_fingerprint",
    "files",
    "cases"
  ],
  "properties": {
    "profile": {
      "const": "extension-package-loader-v1alpha1"
    },
    "seed_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "public_key_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "publisher_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "utf8",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "utf8": {
            "type": "string",
            "maxLength": 2097152
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1073741824
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "rule",
          "payload",
          "archive_manifest",
          "envelope",
          "payload_sha256",
          "archive_manifest_sha256",
          "envelope_sha256",
          "signature_valid",
          "result",
          "decoded_document"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 2097152
          },
          "rule": {
            "type": "string",
            "maxLength": 2097152
          },
          "payload": {
            "type": "string",
            "maxLength": 2097152
          },
          "archive_manifest": {
            "type": "string",
            "maxLength": 2097152
          },
          "envelope": {
            "type": "string",
            "maxLength": 2097152
          },
          "payload_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
          },
          "archive_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
          },
          "envelope_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
          },
          "signature_valid": {
            "type": "boolean"
          },
          "result": {
            "enum": [
              "ok",
              "ErrPayloadMismatch",
              "ErrPublisher",
              "ErrExplicitTag",
              "dsse.ErrSignature"
            ]
          },
          "decoded_document": {
            "type": "object"
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "cases"
  ],
  "properties": {
    "profile": {
      "const": "extension-manifest-loader-v1alpha1"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "yaml",
          "result"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z0-9-]+$(?![\\s\\S])"
          },
          "yaml": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1048576
          },
          "result": {
            "enum": [
              "accept",
              "reject-explicit-tag"
            ]
          }
        }
      }
    }
  }
}

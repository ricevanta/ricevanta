{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "public_key_hex",
    "publisher_fingerprint",
    "file_vectors",
    "cases"
  ],
  "properties": {
    "profile": {
      "const": "extension-manifest-v1alpha1"
    },
    "public_key_hex": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "publisher_fingerprint": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
    },
    "file_vectors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "utf8",
          "size",
          "sha256"
        ],
        "properties": {
          "utf8": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1073741824
          },
          "sha256": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "schema_valid",
          "error",
          "options",
          "manifest"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z0-9-]+$(?![\\s\\S])"
          },
          "schema_valid": {
            "type": "boolean"
          },
          "error": {
            "enum": [
              "ok",
              "ErrOptions",
              "ErrTree",
              "ErrShape",
              "ErrField",
              "ErrReserved",
              "ErrDuplicate",
              "ErrPath",
              "ErrLimit",
              "ErrRequires",
              "ErrReference",
              "ErrCapability",
              "ErrLicense",
              "ErrURL"
            ]
          },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "allow_reserved_id": {
                "type": "boolean"
              },
              "max_total_file_bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "manifest": {
            "type": "object"
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ricevanta.io/schemas/extension/v1alpha1/manifest.schema.json",
  "title": "Ricevanta extension package manifest",
  "description": "Decoded shape only. The Go validator also enforces the semantic rules in docs/specs/extension-manifest.md. This is not the GitOps Extension resource.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec",
    "files"
  ],
  "properties": {
    "apiVersion": {
      "const": "ricevanta.io/v1alpha1"
    },
    "kind": {
      "const": "Extension"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "publisher",
        "license",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "string",
          "minLength": 5,
          "maxLength": 128,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[a-z-][0-9a-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-z-][0-9a-z-]*))*)?$(?![\\s\\S])"
        },
        "publisher": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "key"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$(?![\\s\\S])"
            },
            "key": {
              "type": "string",
              "minLength": 71,
              "maxLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
            }
          }
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9.():+ -]+$(?![\\s\\S])"
        },
        "homepage": {
          "$ref": "#/$defs/url"
        },
        "source": {
          "$ref": "#/$defs/url"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires",
        "components"
      ],
      "properties": {
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "required": [],

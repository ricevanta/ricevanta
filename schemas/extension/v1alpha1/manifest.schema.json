        "required": [
          "path",
          "sha256",
          "size"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1073741824
          }
        }
      }
    }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ricevanta.io/schemas/export/v1alpha1/fixtures.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
          },
          "valid": {
            "type": "boolean"
          },
          "error": {
            "enum": [
              "ErrResource",
              "ErrAdapter",
              "ErrCommon",
              "ErrParameters",
              "ErrCombination"
            ]
          },
          "resource": {}
        },
        "required": [
          "id",
          "valid",
          "resource"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "valid": {
                  "const": false
                }
              },
              "required": [
                "valid"
              ]
            },
            "then": {
              "required": [
                "error"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "error"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "cases"
  ]
}

        {"name": "update_state", "type": "enum", "nullable": false, "filterable": true, "groupable": true, "operators": ["eq", "in", "not_in", "exists"], "aggregations": ["count_distinct"], "description": "Normalized component update state.", "values": ["current", "pending", "running", "failed", "unknown"]},
        {"name": "version", "type": "string", "nullable": false, "filterable": true, "groupable": true, "operators": ["eq", "in", "not_in", "prefix", "exists"], "aggregations": ["count_distinct"], "description": "Observed component version."}
      ]
    },

  "sources": [
    {
      "id": "agents.health",
      "owner": "events",
      "read_permission": "events.health.read",
      "scope": "device_group",
      "footprint": "devices",
      "conditional_reads": [],
      "time_field": "occurred_at",
      "row_aggregations": ["count"],
      "fields": [
        {"name": "component", "type": "string", "nullable": false, "filterable": true, "groupable": true, "operators": ["eq", "in", "not_in", "prefix", "exists"], "aggregations": ["count_distinct"], "description": "Reporting core or component id."},
        {"name": "cpu_percent", "type": "number", "nullable": false, "filterable": true, "groupable": false, "operators": ["eq", "in", "not_in", "gte", "lte", "between", "exists"], "aggregations": ["count_distinct", "sum", "min", "max", "avg", "p50", "p95"], "description": "CPU percentage from the owning sampler."},
        {"name": "device_uid", "type": "string", "nullable": false, "filterable": true, "groupable": true, "operators": ["eq", "in", "not_in", "prefix", "exists"], "aggregations": ["count_distinct"], "description": "Immutable device uid."},
        {"name": "occurred_at", "type": "timestamp", "nullable": false, "filterable": true, "groupable": true, "operators": ["eq", "gte", "lte", "between", "exists"], "aggregations": ["count_distinct"], "description": "Server-normalized event time in UTC."},
        {"name": "rss_bytes", "type": "integer", "nullable": false, "filterable": true, "groupable": false, "operators": ["eq", "in", "not_in", "gte", "lte", "between", "exists"], "aggregations": ["count_distinct", "sum", "min", "max", "avg", "p50", "p95"], "description": "Resident memory in bytes."},
        {"name": "spool_bytes", "type": "integer", "nullable": false, "filterable": true, "groupable": false, "operators": ["eq", "in", "not_in", "gte", "lte", "between", "exists"], "aggregations": ["count_distinct", "sum", "min", "max", "avg", "p50", "p95"], "description": "Used spool bytes."},
        {"name": "within_budget", "type": "boolean", "nullable": false, "filterable": true, "groupable": true, "operators": ["eq", "exists"], "aggregations": ["count_distinct"], "description": "Sampler assessment against AG-09 budgets."}
      ]
    },
    {

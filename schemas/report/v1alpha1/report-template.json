{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ricevanta.io/schemas/report/v1alpha1/report-template.json",
  "title": "ReportTemplate",
  "description": "Decoded authoring shape only. Catalogue references, value compatibility, calendar validity, uniqueness and budgets require the semantic validator; acceptance grants no execution or read authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "ricevanta.io/v1alpha1"
    },
    "kind": {
      "const": "ReportTemplate"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$(?![\\s\\S])"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "datasets",
        "layout"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/localized"
        },
        "parameters": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "datasets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/dataset"
          }
        },
        "layout": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    }
  },
  "$defs": {
    "name": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$(?![\\s\\S])"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-z][a-z0-9_]{0,31}$(?![\\s\\S])"},
    "source": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$(?![\\s\\S])"},
    "scalar": {"oneOf": [{"type": "string", "minLength": 0, "maxLength": 256, "pattern": "^[^\\x00-\\x1f\\x7f]*$(?![\\s\\S])"}, {"type": "number", "minimum": -9007199254740991, "maximum": 9007199254740991}, {"type": "boolean"}]},
    "timestamp": {"type": "string", "minLength": 20, "maxLength": 20, "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$(?![\\s\\S])", "description": "UTC whole seconds; Gregorian validity and start-before-end require semantic checks."},
    "ref": {"type": "object", "additionalProperties": false, "required": ["param"], "properties": {"param": {"$ref": "#/$defs/identifier"}}},
    "groups": {"oneOf": [{"const": "all"}, {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/name"}, "uniqueItems": true}]},
    "time": {"oneOf": [{"enum": ["last_24h", "last_7d", "last_30d", "last_90d", "this_month", "previous_month"]}, {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"$ref": "#/$defs/timestamp"}, "end": {"$ref": "#/$defs/timestamp"}}}]},
    "localized": {"type": "object", "additionalProperties": false, "required": ["en", "vi"], "properties": {"en": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\x00-\\x1f\\x7f]*$(?![\\s\\S])"}, "vi": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\x00-\\x1f\\x7f]*$(?![\\s\\S])"}}},
    "localizedText": {"type": "object", "additionalProperties": false, "required": ["en", "vi"], "properties": {"en": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]*$(?![\\s\\S])"}, "vi": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]*$(?![\\s\\S])"}}},
    "parameter": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["name", "type"], "properties": {"name": {"$ref": "#/$defs/identifier"}, "type": {"const": "time_range"}, "default": {"$ref": "#/$defs/time"}}}, {"type": "object", "additionalProperties": false, "required": ["name", "type"], "properties": {"name": {"$ref": "#/$defs/identifier"}, "type": {"const": "device_groups"}, "default": {"$ref": "#/$defs/groups"}}}, {"type": "object", "additionalProperties": false, "required": ["name", "type", "field"], "properties": {"name": {"$ref": "#/$defs/identifier"}, "type": {"const": "enum_list"}, "default": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\x00-\\x1f\\x7f]*$(?![\\s\\S])"}, "uniqueItems": true}, "field": {"type": "string", "minLength": 1, "maxLength": 97, "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*/[a-z][a-z0-9_]{0,31}$(?![\\s\\S])"}}}, {"type": "object", "additionalProperties": false, "required": ["name", "type"], "properties": {"name": {"$ref": "#/$defs/identifier"}, "type": {"const": "string"}, "default": {"type": "string", "minLength": 0, "maxLength": 256, "pattern": "^[^\\x00-\\x1f\\x7f]*$(?![\\s\\S])"}}}]},
    "operand": {"oneOf": [{"$ref": "#/$defs/scalar"}, {"$ref": "#/$defs/ref"}]},
    "condition": {"oneOf": [{"$ref": "#/$defs/scalar"}, {"$ref": "#/$defs/ref"}, {"type": "object", "additionalProperties": false, "required": ["eq"], "properties": {"eq": {"$ref": "#/$defs/operand"}}}, {"type": "object", "additionalProperties": false, "required": ["in"], "properties": {"in": {"oneOf": [{"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/scalar"}, "uniqueItems": true}, {"$ref": "#/$defs/ref"}]}}}, {"type": "object", "additionalProperties": false, "required": ["not_in"], "properties": {"not_in": {"oneOf": [{"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/scalar"}, "uniqueItems": true}, {"$ref": "#/$defs/ref"}]}}}, {"type": "object", "additionalProperties": false, "required": ["gte"], "properties": {"gte": {"$ref": "#/$defs/operand"}}}, {"type": "object", "additionalProperties": false, "required": ["lte"], "properties": {"lte": {"$ref": "#/$defs/operand"}}}, {"type": "object", "additionalProperties": false, "required": ["between"], "properties": {"between": {"oneOf": [{"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/scalar"}}, {"$ref": "#/$defs/ref"}]}}}, {"type": "object", "additionalProperties": false, "required": ["prefix"], "properties": {"prefix": {"$ref": "#/$defs/operand"}}}, {"type": "object", "additionalProperties": false, "required": ["exists"], "properties": {"exists": {"type": "boolean"}}}]},
    "filter": {"type": "object", "maxProperties": 32, "propertyNames": {"$ref": "#/$defs/identifier"}, "properties": {"time": {"oneOf": [{"$ref": "#/$defs/time"}, {"$ref": "#/$defs/ref"}]}, "device_groups": {"oneOf": [{"$ref": "#/$defs/groups"}, {"$ref": "#/$defs/ref"}]}}, "additionalProperties": {"$ref": "#/$defs/condition"}},
    "measure": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["name", "fn"], "properties": {"name": {"$ref": "#/$defs/identifier"}, "fn": {"const": "count"}}}, {"type": "object", "additionalProperties": false, "required": ["name", "fn", "field"], "properties": {"name": {"$ref": "#/$defs/identifier"}, "fn": {"enum": ["count_distinct", "sum", "min", "max", "avg", "p50", "p95"]}, "field": {"$ref": "#/$defs/identifier"}}}]},
    "dataset": {"type": "object", "additionalProperties": false, "required": ["name", "source", "filter", "measures"], "properties": {"name": {"$ref": "#/$defs/identifier"}, "source": {"$ref": "#/$defs/source"}, "filter": {"$ref": "#/$defs/filter"}, "group_by": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true}, "measures": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/measure"}}, "order_by": {"type": "array", "minItems": 1, "maxItems": 11, "items": {"type": "object", "additionalProperties": false, "required": ["field"], "properties": {"field": {"$ref": "#/$defs/identifier"}, "desc": {"type": "boolean"}}}}, "limit": {"type": "integer", "minimum": 1, "maximum": 10000, "default": 100}}},
    "block": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": {"type": {"const": "heading"}, "text": {"$ref": "#/$defs/localizedText"}}}, {"type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": {"type": {"const": "text"}, "text": {"$ref": "#/$defs/localizedText"}}}, {"type": "object", "additionalProperties": false, "required": ["type", "dataset", "measure", "label"], "properties": {"type": {"const": "kpi"}, "dataset": {"$ref": "#/$defs/identifier"}, "measure": {"$ref": "#/$defs/identifier"}, "label": {"$ref": "#/$defs/localized"}}}, {"type": "object", "additionalProperties": false, "required": ["type", "chart", "dataset", "x", "y"], "properties": {"type": {"const": "chart"}, "chart": {"enum": ["bar", "stacked_bar", "line", "area", "pie", "heatmap"]}, "dataset": {"$ref": "#/$defs/identifier"}, "x": {"$ref": "#/$defs/identifier"}, "y": {"$ref": "#/$defs/identifier"}, "series": {"$ref": "#/$defs/identifier"}}, "allOf": [{"if": {"properties": {"chart": {"enum": ["stacked_bar", "heatmap"]}}}, "then": {"required": ["series"]}}, {"if": {"properties": {"chart": {"const": "pie"}}}, "then": {"not": {"required": ["series"]}}}]}, {"type": "object", "additionalProperties": false, "required": ["type", "dataset", "columns"], "properties": {"type": {"const": "table"}, "dataset": {"$ref": "#/$defs/identifier"}, "columns": {"type": "array", "minItems": 1, "maxItems": 11, "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true}}}]}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ricevanta.io/schemas/build/root/v1/build-root.schema.json",
  "title": "Ricevanta Linux build root pins",
  "description": "Pins for the Linux build root, its ABI floor and the distribution probe images (docs/specs/linux-build-root.md). Semantic checks such as numeric ceiling comparison and runner-to-platform agreement belong to scripts/release/build_root.py and elf_abi.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "floor",
    "roots",
    "probes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "floor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "glibc",
        "architectures"
      ],
      "properties": {
        "glibc": {
          "$ref": "#/$defs/version"
        },
        "architectures": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x86_64",
            "aarch64"
          ],
          "properties": {
            "x86_64": {
              "allOf": [
                {
                  "$ref": "#/$defs/abi"
                },
                {
                  "properties": {
                    "interpreter": {
                      "const": "/lib64/ld-linux-x86-64.so.2"
                    }
                  }
                }
              ]
            },
            "aarch64": {
              "allOf": [
                {
                  "$ref": "#/$defs/abi"
                },
                {
                  "properties": {
                    "interpreter": {
                      "const": "/lib/ld-linux-aarch64.so.1"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x86_64",
        "aarch64"
      ],
      "properties": {
        "x86_64": {
          "allOf": [
            {
              "$ref": "#/$defs/root"
            },
            {
              "properties": {
                "runner": {
                  "const": "ubuntu-26.04"
                },
                "platform": {
                  "const": "linux-x64-ubuntu26.04"
                }
              }
            }
          ]
        },
        "aarch64": {
          "allOf": [
            {
              "$ref": "#/$defs/root"
            },
            {
              "properties": {
                "runner": {
                  "const": "ubuntu-26.04-arm"
                },
                "platform": {
                  "const": "linux-arm64-ubuntu26.04"
                }
              }
            }
          ]
        }
      }
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/probe"
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*)){1,3}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9._+-]+(/[A-Za-z0-9._+-]+)*$",
      "not": {
        "pattern": "(^|/)\\.\\.?(/|$)"
      }
    },
    "soname": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_+-]+(\\.[A-Za-z0-9_+-]+)*\\.so(\\.[0-9]+)+$"
    },
    "namespace": {
      "enum": [
        "GLIBC",
        "GCC",
        "GLIBCXX",
        "CXXABI"
      ]
    },
    "abi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interpreter",
        "sonames",
        "ceilings",
        "cflags",
        "rootObjects"
      ],
      "properties": {
        "interpreter": {
          "enum": [
            "/lib64/ld-linux-x86-64.so.2",
            "/lib/ld-linux-aarch64.so.1"
          ]
        },
        "sonames": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/soname"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/namespace"
            }
          }
        },
        "ceilings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "GLIBC",
            "GCC",
            "GLIBCXX",
            "CXXABI"
          ],
          "properties": {
            "GLIBC": {
              "$ref": "#/$defs/version"
            },
            "GCC": {
              "$ref": "#/$defs/version"
            },
            "GLIBCXX": {
              "$ref": "#/$defs/version"
            },
            "CXXABI": {
              "$ref": "#/$defs/version"
            }
          }
        },
        "cflags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^-m(arch|tune)=[a-z0-9.-]+$"
          }
        },
        "rootObjects": {
          "description": "Object files and archive members from the root that may enter a binary, after path normalization inside the root.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9._+-]+(/[A-Za-z0-9._+-]+)*\\.(o|a\\([A-Za-z0-9._+-]+\\))$",
            "not": {
              "pattern": "(^|/)\\.\\.?(/|$)"
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "manifestDigest",
        "configDigest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*\\.[a-z]{2,}(/[a-z0-9]+([._-][a-z0-9]+)*)+$"
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
        },
        "manifestDigest": {
          "$ref": "#/$defs/digest"
        },
        "configDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "platform",
        "image",
        "vendorKey",
        "packages",
        "cc",
        "ar"
      ],
      "properties": {
        "runner": {
          "enum": [
            "ubuntu-26.04",
            "ubuntu-26.04-arm"
          ]
        },
        "platform": {
          "enum": [
            "linux-x64-ubuntu26.04",
            "linux-arm64-ubuntu26.04"
          ]
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "vendorKey": {
          "type": "string",
          "pattern": "^[0-9A-F]{40}$"
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._+-]+-[0-9][A-Za-z0-9._+~^]*-[A-Za-z0-9._+~^]+\\.(x86_64|aarch64|noarch)$"
          }
        },
        "cc": {
          "$ref": "#/$defs/absolutePath"
        },
        "ar": {
          "$ref": "#/$defs/absolutePath"
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "release",
        "images"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
        },
        "family": {
          "enum": [
            "ubuntu",
            "debian",
            "almalinux",
            "rocky",
            "fedora",
            "opensuse-leap"
          ]
        },
        "release": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "x86_64": {
              "$ref": "#/$defs/image"
            },
            "aarch64": {
              "$ref": "#/$defs/image"
            }
          },
          "required": [
            "x86_64",
            "aarch64"
          ]
        }
      }
    }
  }
}

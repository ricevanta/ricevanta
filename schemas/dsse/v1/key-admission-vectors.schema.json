{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ricevanta Ed25519 key admission vectors v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "ricevanta-ed25519-key-admission-v1"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/vector"
      }
    }
  },
  "required": [
    "format",
    "vectors"
  ],
  "$defs": {
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
        },
        "kind": {
          "enum": [
            "length",
            "y-sign",
            "torsion",
            "base",
            "mixed",
            "seed"
          ]
        },
        "recipe": {
          "type": "object"
        },
        "public_key_hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})*(?![\\s\\S])",
          "maxLength": 128
        },
        "expected": {
          "enum": [
            "accept",
            "ErrLength",
            "ErrNonCanonical",
            "ErrPoint",
            "ErrSmallOrder",
            "ErrMixedOrder"
          ]
        }
      },
      "required": [
        "name",
        "kind",
        "recipe",
        "public_key_hex",
        "expected"
      ],
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "length"
            },
            "recipe": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "length": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 64
                }
              },
              "required": [
                "length"
              ]
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "y-sign"
            },
            "recipe": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "y": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])",
                  "maxLength": 78
                },
                "sign": {
                  "enum": [
                    0,
                    1
                  ]
                }
              },
              "required": [
                "y",
                "sign"
              ]
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "torsion"
            },
            "recipe": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "multiple": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 7
                }
              },
              "required": [
                "multiple"
              ]
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "base"
            },
            "recipe": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "scalar": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])",
                  "maxLength": 78
                }
              },
              "required": [
                "scalar"
              ]
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "mixed"
            },
            "recipe": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "scalar": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])",
                  "maxLength": 78
                },
                "multiple": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 7
                }
              },
              "required": [
                "scalar",
                "multiple"
              ]
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "seed"
            },
            "recipe": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "seed_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
                }
              },
              "required": [
                "seed_hex"
              ]
            }
          }
        }
      ]
    }
  }
}

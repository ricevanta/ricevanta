{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ricevanta.io/schemas/agent/health/v1/health.schema.json",
  "title": "Ricevanta agent health document v1",
  "description": "The health.json document the agent writes atomically each interval (docs/specs/agent-runtime.md section 7). Local status only; it carries no authority and is not an OCSF event.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pid", "state", "version", "commit", "channel", "mode", "written_unix_ms", "uptime_ms", "interval_ms", "process", "counters", "errors"],
  "properties": {
    "schema": { "const": "ricevanta-agent-health-v1" },
    "pid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "state": { "enum": ["starting", "ready", "stopping", "stopped"] },
    "version": { "type": "string", "minLength": 5, "maxLength": 128, "pattern": "^[0-9A-Za-z.+-]+$(?![\\s\\S])" },
    "commit": { "type": "string", "pattern": "^(?:unknown|[0-9a-f]{40})$(?![\\s\\S])" },
    "channel": { "enum": ["pr", "master", "prerelease", "local"] },
    "mode": { "enum": ["run", "service"] },
    "written_unix_ms": { "$ref": "#/$defs/u64" },
    "uptime_ms": { "$ref": "#/$defs/u64" },
    "interval_ms": { "type": "integer", "minimum": 100, "maximum": 3600000 },
    "process": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/processSample" }
      ]
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples", "sample_failures", "log_errors", "health_write_failures", "stop_requests"],
      "properties": {
        "samples": { "$ref": "#/$defs/u64" },
        "sample_failures": { "$ref": "#/$defs/u64" },
        "log_errors": { "$ref": "#/$defs/u64" },
        "health_write_failures": { "$ref": "#/$defs/u64" },
        "stop_requests": { "$ref": "#/$defs/u64" }
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "enum": ["sampler_failed", "log_write_failed", "health_write_failed", "watchdog_notify_failed", "shutdown_timeout"] }
    }
  },
  "$defs": {
    "u64": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "processSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["footprint_bytes", "footprint_metric", "cpu_user_ms", "cpu_system_ms", "threads"],
      "properties": {
        "footprint_bytes": { "$ref": "#/$defs/u64" },
        "footprint_metric": { "enum": ["phys_footprint", "private_working_set", "pss"] },
        "cpu_user_ms": { "$ref": "#/$defs/u64" },
        "cpu_system_ms": { "$ref": "#/$defs/u64" },
        "threads": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "fd_count": { "$ref": "#/$defs/u64" },
        "handle_count": { "$ref": "#/$defs/u64" }
      },
      "allOf": [
        {
          "if": { "properties": { "footprint_metric": { "const": "private_working_set" } } },
          "then": { "required": ["handle_count"], "not": { "required": ["fd_count"] } },
          "else": { "required": ["fd_count"], "not": { "required": ["handle_count"] } }
        }
      ]
    }
  }
}

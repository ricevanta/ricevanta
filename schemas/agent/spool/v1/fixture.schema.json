{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ricevanta.io/schemas/agent/spool/v1/fixture.schema.json",
  "title": "Agent spool v1 recovery fixtures",
  "type": "object",
  "properties": {
    "format": {
      "const": "ricevanta-spool-v1"
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    }
  },
  "required": [
    "format",
    "fixtures"
  ],
  "additionalProperties": false,
  "$defs": {
    "u64": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)(?![\\s\\S])"
    },
    "hex": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})*(?![\\s\\S])",
      "maxLength": 4194304
    },
    "header": {
      "type": "object",
      "properties": {
        "class_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "stream_epoch": {
          "allOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "not": {
                "const": "0"
              }
            }
          ]
        },
        "segment_id": {
          "$ref": "#/$defs/u64"
        },
        "first_sequence": {
          "$ref": "#/$defs/u64"
        }
      },
      "required": [
        "class_id",
        "stream_epoch",
        "segment_id",
        "first_sequence"
      ],
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "properties": {
        "sequence": {
          "$ref": "#/$defs/u64"
        },
        "payload_hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})*(?![\\s\\S])",
          "maxLength": 2097152
        }
      },
      "required": [
        "sequence",
        "payload_hex"
      ],
      "additionalProperties": false
    },
    "tail": {
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2097152
        },
        "kind": {
          "enum": [
            "Incomplete",
            "Checksum"
          ]
        }
      },
      "required": [
        "offset",
        "kind"
      ],
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "properties": {
        "header": {
          "$ref": "#/$defs/header"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "valid_len": {
          "type": "integer",
          "minimum": 32,
          "maximum": 2097152
        },
        "next_sequence": {
          "oneOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        },
        "tail": {
          "oneOf": [
            {
              "$ref": "#/$defs/tail"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "header",
        "records",
        "valid_len",
        "next_sequence",
        "tail"
      ],
      "additionalProperties": false
    },
    "error": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "HeaderTooShort"
            },
            "actual": {
              "type": "integer",
              "minimum": 0,
              "maximum": 31
            }
          },
          "required": [
            "kind",
            "actual"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Magic"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Version"
            },
            "found": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "required": [
            "kind",
            "found"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Class"
            },
            "found": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "required": [
            "kind",
            "found"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Reserved"
            },
            "found": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "required": [
            "kind",
            "found"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "StreamEpoch"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "PayloadTooLarge"
            },
            "length": {
              "type": "integer",
              "minimum": 1048577,
              "maximum": 4294967295
            }
          },
          "required": [
            "kind",
            "length"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "Sequence"
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2097152
            },
            "expected": {
              "oneOf": [
                {
                  "$ref": "#/$defs/u64"
                },
                {
                  "type": "null"
                }
              ]
            },
            "found": {
              "$ref": "#/$defs/u64"
            }
          },
          "required": [
            "kind",
            "offset",
            "expected",
            "found"
          ],
          "additionalProperties": false
        }
      ]
    },
    "fixture": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*(?![\\s\\S])"
        },
        "segment_hex": {
          "$ref": "#/$defs/hex"
        },
        "expected": {
          "oneOf": [
            {
              "$ref": "#/$defs/success"
            },
            {
              "type": "object",
              "properties": {
                "error": {
                  "$ref": "#/$defs/error"
                }
              },
              "required": [
                "error"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "segment_hex",
        "expected"
      ],
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ricevanta.io/schemas/agent/json/v1/vectors.schema.json",
  "title": "ricevanta-json strict reader vectors v1",
  "description": "Shared vectors for the bounded JSON reader of docs/specs/agent-runtime.md section 3. Inputs are hex so invalid UTF-8 and byte-order marks can be expressed. An accepted input re-encodes to canonical_hex: sorted keys, no whitespace, shortest escapes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "cases"],
  "properties": {
    "format": { "const": "ricevanta-json-v1" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})*$(?![\\s\\S])", "maxLength": 262144 },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "input_hex", "expected"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$(?![\\s\\S])", "maxLength": 64 },
        "input_hex": { "$ref": "#/$defs/hex" },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["result", "canonical_hex"],
              "properties": {
                "result": { "const": "accept" },
                "canonical_hex": { "$ref": "#/$defs/hex" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["result", "error"],
              "properties": {
                "result": { "const": "reject" },
                "error": {
                  "enum": ["Utf8", "ByteOrderMark", "TooLarge", "TooDeep", "DuplicateKey", "Syntax", "NumberFormat", "NumberRange", "Trailing", "Surrogate", "Control"]
                }
              }
            }
          ]
        }
      }
    }
  }
}

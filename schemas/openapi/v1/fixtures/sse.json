{
 "description": "Change-stream framing (encoder bytes), WHATWG event-stream parsing over chunk boundaries and topic subscription decisions of docs/specs/change-stream.md.",
 "cases": [
  {
   "id": "encode-open",
   "kind": "encode",
   "items": [
    {
     "kind": "retry",
     "ms": 5000
    },
    {
     "kind": "event",
     "event": "snapshot",
     "data": {
      "stream_uid": "01928f3e-7a4b-7c3d-8e9f-0a1b2c3d4e71",
      "topics": [
       {
        "topic": "devices",
        "token": "AAAAAAAAAAAAAAAAAAAAAA"
       },
       {
        "topic": "device/01928f3e-7a4b-7c3d-8e9f-0a1b2c3d4e5f",
        "token": "q2Zb-x_9Lk0aQ1w2E3r4T5"
       }
      ]
     }
    }
   ],
   "expect": "retry: 5000\n\nevent: snapshot\ndata: {\"stream_uid\":\"01928f3e-7a4b-7c3d-8e9f-0a1b2c3d4e71\",\"topics\":[{\"token\":\"AAAAAAAAAAAAAAAAAAAAAA\",\"topic\":\"devices\"},{\"token\":\"q2Zb-x_9Lk0aQ1w2E3r4T5\",\"topic\":\"device/01928f3e-7a4b-7c3d-8e9f-0a1b2c3d4e5f\"}]}\n\n"
  },
  {
   "id": "encode-change",
   "kind": "encode",
   "items": [
    {
     "kind": "event",
     "event": "change",
     "data": {
      "topic": "alerts",
      "token": "q2Zb-x_9Lk0aQ1w2E3r4T5"
     }
    }
   ],
   "expect": "event: change\ndata: {\"token\":\"q2Zb-x_9Lk0aQ1w2E3r4T5\",\"topic\":\"alerts\"}\n\n"
  },
  {
   "id": "encode-heartbeat",
   "kind": "encode",
   "items": [
    {
     "kind": "comment",
     "text": "keepalive"
    }
   ],
   "expect": ": keepalive\n\n"
  },
  {
   "id": "encode-session-ended",
   "kind": "encode",
   "items": [
    {
     "kind": "event",
     "event": "session",
     "data": {
      "state": "ended"
     }
    }
   ],
   "expect": "event: session\ndata: {\"state\":\"ended\"}\n\n"
  },
  {
   "id": "encode-reconnect",
   "kind": "encode",
   "items": [
    {
     "kind": "event",
     "event": "reconnect",
     "data": {
      "reason": "shutdown"
     }
    }
   ],
   "expect": "event: reconnect\ndata: {\"reason\":\"shutdown\"}\n\n"
  },
  {
   "id": "parse-basic",
   "kind": "parse",
   "chunks": [
    "event: change\ndata: {\"a\":1}\n\n"
   ],
   "expect": {
    "events": [
     {
      "event": "change",
      "data": "{\"a\":1}",
      "last_event_id": ""
     }
    ],
    "retry": null
   }
  },
  {
   "id": "parse-split-crlf",
   "kind": "parse",
   "chunks": [
    "event: change\r",
    "\ndata: x\r\n\r\n"
   ],
   "expect": {
    "events": [
     {
      "event": "change",
      "data": "x",
      "last_event_id": ""
     }
    ],
    "retry": null
   }
  },
  {
   "id": "parse-cr-only",
   "kind": "parse",
   "chunks": [
    "data: a\rdata: b\r\r"
   ],
   "expect": {
    "events": [
     {
      "event": "message",
      "data": "a\nb",
      "last_event_id": ""
     }
    ],
    "retry": null
   }
  },
  {
   "id": "parse-comment-retry",
   "kind": "parse",
   "chunks": [
    ": keepalive\n\nretry: 5000\n\n",
    "retry: 50x\n\n"
   ],
   "expect": {
    "events": [],
    "retry": 5000
   }
  },
  {
   "id": "parse-bom-no-space",
   "kind": "parse",
   "chunks": [
    "\ufeffevent:session\ndata:{\"state\":\"ended\"}\n\n"

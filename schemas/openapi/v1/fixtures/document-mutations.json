{
 "description": "Single mutations of openapi.yaml, each of which the validator must reject with the named rule code (schemas/openapi/v1/test_validate.py).",
 "cases": [
  {
   "id": "remove-authorization",
   "description": "An operation without its authorization binding",
   "ops": [
    {
     "op": "delete",
     "path": "/paths/~1api~1v1~1sessions/get/x-ricevanta-authorization"
    }
   ],
   "expect": "R05"
  },
  {
   "id": "unknown-permission",
   "description": "Binding names a permission that is not in the catalogue",
   "ops": [
    {
     "op": "set",
     "path": "/paths/~1api~1v1~1sessions/get/x-ricevanta-authorization/permissions/0/name",
     "value": "identity.sessions.list"
    }
   ],
   "expect": "R07"
  },
  {
   "id": "foreign-use",
   "description": "Binding names a catalogue use of another operation",
   "ops": [
    {
     "op": "set",
     "path": "/paths/~1api~1v1~1sessions/get/x-ricevanta-authorization/permissions/0/uses",
     "value": "listUsers"
    }
   ],
   "expect": "R07"
  },
  {

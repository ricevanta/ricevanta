   "input": {
    "session_kind": "break_glass",
    "idle": 300,
    "absolute": 3600
   },
   "expect": true
  },
  {
   "id": "config-break-glass-idle-high",
   "kind": "config",
   "input": {
    "session_kind": "break_glass",
    "idle": 901,

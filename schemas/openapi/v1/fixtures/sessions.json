{
 "description": "Session expiry precedence, idle-activity throttling, timeout configuration ranges and exact Set-Cookie strings in net/http Cookie.String attribute order (docs/specs/identity-sessions.md sections 2 and 3). Times are seconds.",
 "cases": [
  {
   "id": "timeout-fresh",
   "kind": "timeout",
   "input": {
    "session_kind": "sso",
    "created_at": 0,
    "last_activity_at": 0,
    "now": 1,
    "idle_timeout": 900,
    "absolute_timeout": 28800,
    "revoked": false
   },
   "expect": "valid"
  },
  {
   "id": "timeout-idle-boundary-minus-one",
   "kind": "timeout",
   "input": {
    "session_kind": "sso",
    "created_at": 0,
    "last_activity_at": 0,
    "now": 899,
    "idle_timeout": 900,
    "absolute_timeout": 28800,
    "revoked": false
   },
   "expect": "valid"
  },
  {
   "id": "timeout-idle-boundary",
   "kind": "timeout",
   "input": {
    "session_kind": "sso",
    "created_at": 0,
    "last_activity_at": 0,
    "now": 900,
    "idle_timeout": 900,
    "absolute_timeout": 28800,
    "revoked": false
   },
   "expect": "idle_expired"
  },
  {
   "id": "timeout-activity-extends",
   "kind": "timeout",
   "input": {
    "session_kind": "sso",
    "created_at": 0,
    "last_activity_at": 28000,
    "now": 28799,
    "idle_timeout": 900,
    "absolute_timeout": 28800,
    "revoked": false
   },
   "expect": "valid"
  },
  {
   "id": "timeout-absolute-boundary",
   "kind": "timeout",
   "input": {
    "session_kind": "sso",
    "created_at": 0,
    "last_activity_at": 28700,
    "now": 28800,
    "idle_timeout": 900,
    "absolute_timeout": 28800,
    "revoked": false
   },
   "expect": "absolute_expired"
  },
  {
   "id": "timeout-absolute-before-idle",
   "kind": "timeout",
   "input": {
    "session_kind": "sso",
    "created_at": 0,
    "last_activity_at": 0,
    "now": 30000,
    "idle_timeout": 900,
    "absolute_timeout": 28800,
    "revoked": false
   },
   "expect": "absolute_expired"
  },
  {
   "id": "timeout-revoked-wins",
   "kind": "timeout",
   "input": {
    "session_kind": "sso",
    "created_at": 0,
    "last_activity_at": 0,
    "now": 30000,
    "idle_timeout": 900,
    "absolute_timeout": 28800,
    "revoked": true
   },
   "expect": "revoked"
  },
  {
   "id": "timeout-break-glass-idle",
   "kind": "timeout",
   "input": {
    "session_kind": "break_glass",
    "created_at": 0,
    "last_activity_at": 0,
    "now": 300,
    "idle_timeout": 300,
    "absolute_timeout": 3600,
    "revoked": false
   },
   "expect": "idle_expired"
  },
  {
   "id": "timeout-break-glass-absolute",
   "kind": "timeout",
   "input": {
    "session_kind": "break_glass",
    "created_at": 0,
    "last_activity_at": 3500,
    "now": 3600,
    "idle_timeout": 300,
    "absolute_timeout": 3600,
    "revoked": false
   },
   "expect": "absolute_expired"
  },
  {
   "id": "activity-updates",
   "kind": "activity",
   "input": {
    "stored_last_activity": 100,
    "now": 130,
    "background": false
   },
   "expect": 130

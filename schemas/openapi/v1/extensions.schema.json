{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ricevanta.io/schemas/openapi/v1/extensions.schema.json",
  "title": "x-ricevanta-authorization",
  "description": "Authorization binding carried by every /api/v1 operation (docs/specs/api-foundation.md section 8).",
  "type": "object",
  "additionalProperties": false,
  "required": ["principal", "reauth", "csrf"],
  "properties": {
    "principal": {"enum": ["public", "protocol", "subject", "permission"]},
    "protocol": {"enum": ["oidc_callback", "saml_acs", "local_login", "enrollment_code", "setup_token"]},
    "credentials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["session", "token"]}
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "uses"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}\\.[a-z][a-z0-9_]{0,31}\\.[a-z][a-z0-9_]{0,31}$"},
          "uses": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]{2,63}(#[a-z][a-z0-9-]{0,31})?$"},
          "selector": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}
        }
      }
    },
    "reauth": {"enum": ["none", "recent", "bound"]},
    "csrf": {"enum": ["none", "synchronizer", "origin", "navigation", "navigation_callback", "cross_site_post"]}
  },
  "allOf": [
    {
      "if": {"properties": {"principal": {"const": "protocol"}}},
      "then": {"required": ["protocol"], "not": {"anyOf": [{"required": ["credentials"]}, {"required": ["permissions"]}]}},
      "else": {"not": {"required": ["protocol"]}}
    },
    {
      "if": {"properties": {"principal": {"const": "public"}}},
      "then": {"not": {"anyOf": [{"required": ["credentials"]}, {"required": ["permissions"]}]}}
    },
    {
      "if": {"properties": {"principal": {"enum": ["subject", "permission"]}}},
      "then": {"required": ["credentials"]}
    },
    {
      "if": {"properties": {"principal": {"const": "permission"}}},
      "then": {"required": ["permissions"]}
    }
  ]
}

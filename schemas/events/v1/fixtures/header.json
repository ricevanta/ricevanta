      "expected_error": "wire.ErrHeaderSyntax"
    },
    {
      "name": "version-overflow",
      "header_values": [
        "v=256;class=raw;epoch=1;segment=0;first=0;last=0;count=1"
      ],
      "expected_error": "wire.ErrHeaderSyntax"
    },
    {
      "name": "overflow-before-version",
      "header_values": [
        "v=2;class=raw;epoch=18446744073709551616;segment=0;first=0;last=0;count=1"
      ],
      "expected_error": "wire.ErrHeaderSyntax"
    },
    {
      "name": "version-0",
      "header_values": [
        "v=0;class=raw;epoch=1;segment=0;first=0;last=0;count=1"
      ],
      "expected_error": "wire.ErrVersion"
    },
    {
      "name": "version-2",
      "header_values": [
        "v=2;class=raw;epoch=1;segment=0;first=0;last=0;count=1"
      ],
      "expected_error": "wire.ErrVersion"
    },
    {
      "name": "version-255",
      "header_values": [
        "v=255;class=raw;epoch=1;segment=0;first=0;last=0;count=1"
      ],
      "expected_error": "wire.ErrVersion"
    },
    {
      "name": "unknown-class",
      "header_values": [
        "v=1;class=other;epoch=0;segment=0;first=0;last=0;count=1"
      ],
      "expected_error": "batch.ErrClass"
    },
    {
      "name": "zero-epoch",
      "header_values": [
        "v=1;class=raw;epoch=0;segment=0;first=0;last=0;count=0"
      ],
      "expected_error": "batch.ErrStreamEpoch"
    },
    {
      "name": "zero-count",
      "header_values": [
        "v=1;class=raw;epoch=1;segment=0;first=5;last=0;count=0"
      ],
      "expected_error": "batch.ErrRecordCount"
    },
    {
      "name": "count-10001",
      "header_values": [
        "v=1;class=raw;epoch=1;segment=0;first=0;last=0;count=10001"
      ],
      "expected_error": "batch.ErrRecordCount"
    },
    {
      "name": "u32-max",
      "header_values": [
        "v=1;class=raw;epoch=1;segment=0;first=0;last=0;count=4294967295"
      ],
      "expected_error": "batch.ErrRecordCount"
    },
    {
      "name": "reverse",
      "header_values": [
        "v=1;class=raw;epoch=1;segment=0;first=18446744073709551615;last=0;count=1"
      ],
      "expected_error": "batch.ErrSequenceRange"
    },
    {
      "name": "count-mismatch",
      "header_values": [
        "v=1;class=raw;epoch=1;segment=0;first=18446744073709551615;last=18446744073709551615;count=2"
      ],
      "expected_error": "batch.ErrSequenceCount"
    },
    {
      "name": "version-before-class",
      "header_values": [
        "v=2;class=other;epoch=0;segment=0;first=0;last=0;count=1"
      ],
      "expected_error": "wire.ErrVersion"
    }
  ]
}

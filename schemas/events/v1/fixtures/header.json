      "expected_error": "wire.ErrHeaderSyntax"
    },
    {
      "name": "extra",
      "header_values": [
        "v=1;class=raw;epoch=1;segment=0;first=0;last=0;count=1;device=1"
      ],
      "expected_error": "wire.ErrHeaderSyntax"
    },
    {
      "name": "missing-key",
      "header_values": [
        "v=1;class=raw;epoch=1;segment=0;first=0;count=1"
      ],
      "expected_error": "wire.ErrHeaderSyntax"
    },
    {
      "name": "duplicate-key",
      "header_values": [
        "v=1;class=raw;epoch=1;segment=0;first=0;first=0;count=1"
      ],
      "expected_error": "wire.ErrHeaderSyntax"
    },
    {
      "name": "reordered",
      "header_values": [
        "v=1;class=raw;epoch=1;segment=0;last=0;first=0;count=1"
      ],
      "expected_error": "wire.ErrHeaderSyntax"
    },
    {
      "name": "quoted",
      "header_values": [
        "v=1;class=\"raw\";epoch=1;segment=0;first=0;last=0;count=1"
      ],
      "expected_error": "wire.ErrHeaderSyntax"
    },
    {
      "name": "nul",
      "header_values": [
        "v=1;class=raw;epoch=1;segment=0;first=0;last=0;count=1\u0000"
      ],
      "expected_error": "wire.ErrHeaderSyntax"
    },
    {
      "name": "crlf",
      "header_values": [
        "v=1;class=raw;epoch=1;segment=0;first=0;last=0;count=1\r\n"
      ],
      "expected_error": "wire.ErrHeaderSyntax"
    },
    {
      "name": "unicode",
      "header_values": [
        "v=1;class=r\u00e4w;epoch=1;segment=0;first=0;last=0;count=1"
      ],
      "expected_error": "wire.ErrHeaderSyntax"
    },
    {
      "name": "empty-token",
      "header_values": [
        "v=1;class=raw;epoch=1;segment=0;first=0;last=0;count="
      ],
      "expected_error": "wire.ErrHeaderSyntax"
    },
    {
      "name": "sign",
      "header_values": [
        "v=1;class=raw;epoch=+1;segment=0;first=0;last=0;count=1"
      ],
      "expected_error": "wire.ErrHeaderSyntax"
    },
    {
      "name": "hex",
      "header_values": [
        "v=1;class=raw;epoch=0x1;segment=0;first=0;last=0;count=1"
      ],
      "expected_error": "wire.ErrHeaderSyntax"
    },
    {
      "name": "exponent",
      "header_values": [
        "v=1;class=raw;epoch=1e0;segment=0;first=0;last=0;count=1"
      ],
      "expected_error": "wire.ErrHeaderSyntax"

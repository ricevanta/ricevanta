      "expected_error": "wire.ErrHeaderSyntax"
    },
    {
      "name": "internal-space",
      "header_values": [
        "v=1; class=raw;epoch=1;segment=0;first=0;last=0;count=1"
      ],
      "expected_error": "wire.ErrHeaderSyntax"
    },
    {
      "name": "upper-key",
      "header_values": [
        "v=1;Class=raw;epoch=1;segment=0;first=0;last=0;count=1"
      ],
      "expected_error": "wire.ErrHeaderSyntax"
    },
    {
      "name": "upper-class",
      "header_values": [
        "v=1;class=RAW;epoch=1;segment=0;first=0;last=0;count=1"
      ],
      "expected_error": "wire.ErrHeaderSyntax"
    },
    {
      "name": "comma",
      "header_values": [
        "v=1;class=raw;epoch=1;segment=0;first=0;last=0;count=1,v=1;class=raw;epoch=1;segment=0;first=0;last=0;count=1"

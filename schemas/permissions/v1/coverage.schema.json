{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ricevanta.io/schemas/permissions/v1/coverage.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documents",
    "actions",
    "exemptions"
  ],
  "properties": {
    "documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^docs/(design|specs)/[a-z0-9-]+\\.md$(?![\\s\\S])"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner",
          "note",
          "id",
          "source",
          "anchor",
          "name",
          "scope",
          "rule",
          "requires",
          "checks"
        ],
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\x20-\\x7e]+$(?![\\s\\S])"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\x20-\\x7e]+$(?![\\s\\S])",
            "maxLength": 512
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\x20-\\x7e]+$(?![\\s\\S])"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\x20-\\x7e]+$(?![\\s\\S])"
          },
          "anchor": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\x20-\\x7e]+$(?![\\s\\S])"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}\\.[a-z][a-z0-9_]{0,31}\\.[a-z][a-z0-9_]{0,31}$(?![\\s\\S])"
          },
          "scope": {
            "enum": [
              "organization",
              "device_group"
            ]
          },
          "rule": {
            "enum": [
              "none",
              "always",
              "policy_change",
              "extension_dependency",
              "destination_change",
              "published_content",
              "group_change",
              "child_union"
            ]
          },
          "requires": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[\\x20-\\x7e]+$(?![\\s\\S])"
            }
          },
          "checks": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\x20-\\x7e]+$(?![\\s\\S])"
          }
        }
      }
    },
    "exemptions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "authority"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\x20-\\x7e]+$(?![\\s\\S])"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\x20-\\x7e]+$(?![\\s\\S])"
          },
          "authority": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\x20-\\x7e]+$(?![\\s\\S])"
          }
        }
      }
    }
  }
}
